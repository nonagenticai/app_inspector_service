# =============================================================================
# App Inspector Service - Development Environment Configuration
# =============================================================================
# Copy to .env and adjust values as needed

# Application
ENVIRONMENT=development
APP_NAME=App Inspector Service
APP_VERSION=0.1.0

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5461/app_inspector_service  # pragma: allowlist secret
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6401/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_DECODE_RESPONSES=true
# Detect a stale/dead socket in the pool via a periodic PING instead of only
# on first use (see issue #93 — a worker4 reboot left a 55min-stale socket).
# 0 = disabled (w2v_common.RedisClient default). Set in the deployed
# ConfigMap, not here — this file documents the knob only.
REDIS_HEALTH_CHECK_INTERVAL=30

# API Settings
API_HOST=0.0.0.0
API_PORT=6311
API_DEBUG=true
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Authentication
AUTH_ENABLED=false
DEFAULT_TENANT_ID=n8n-dev

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data

# Appium
APPIUM_SERVER_URL=http://localhost:4723

# Device Farm: the provider and any BrowserStack credentials are sent PER
# REQUEST in InspectRequest.device_farm (held in memory only, never persisted);
# there is no service-level device farm configuration.

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
LOG_JSON_LOGS=false

# =============================================================================
# Docker Overrides (when running inside docker-compose)
# =============================================================================
# DATABASE_URL=postgresql+psycopg://postgres:changeme@app_inspector_service_postgres:5432/app_inspector_service  # pragma: allowlist secret
# REDIS_URL=redis://app-inspector-service-redis:6379/0
# STORAGE_LOCAL_PATH=/app/data
